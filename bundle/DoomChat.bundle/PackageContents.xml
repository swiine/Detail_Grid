<?xml version="1.0" encoding="utf-8"?>
<!--
  DoomChat bundle: CivDOOM (the game) and DoomChat (its lobby chat) in one package. Install-DoomChat.cmd copies
  this folder to %APPDATA%\Autodesk\ApplicationPlugins\ and Civil 3D loads both on startup; Uninstall-DoomChat.cmd
  removes both. Contents\doomchat.defaults.json sets the shared folder everyone uses.
-->
<ApplicationPackage
    SchemaVersion="1.0"
    AppVersion="1.1.0"
    Name="DoomChat"
    Description="CivDOOM - a Doom-style shooter built from your drawing - with co-op multiplayer and a lobby chat."
    Author="Detail_Grid"
    ProductCode="{6C1A6D3E-2B7F-4E0B-9C57-3E8F1D2A9B41}"
    UpgradeCode="{0F4E2C8B-7A15-4D39-8E62-5B1C9A7D3F20}">
  <CompanyDetails Name="Detail_Grid" />
  <Components Description="CivDOOM and DoomChat for AutoCAD 2025+ based products">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R25.0" />
    <ComponentEntry
        AppName="CivDOOM"
        ModuleName="./Contents/CivDoom.Civil3D.dll"
        AppDescription="Type CIVDOOM to play, CIVDOOMHOST to play together."
        LoadOnAutoCADStartup="True">
      <Commands GroupName="CIVDOOM">
        <Command Global="CIVDOOM" Local="CIVDOOM" />
        <Command Global="CIVDOOMWINDOW" Local="CIVDOOMWINDOW" />
        <Command Global="CIVDOOMGEN" Local="CIVDOOMGEN" />
        <Command Global="CIVDOOMBLOCKS" Local="CIVDOOMBLOCKS" />
        <Command Global="CIVDOOMTHEME" Local="CIVDOOMTHEME" />
        <Command Global="CIVDOOMHOST" Local="CIVDOOMHOST" />
        <Command Global="CIVDOOMJOIN" Local="CIVDOOMJOIN" />
        <Command Global="CIVDOOMGAMES" Local="CIVDOOMGAMES" />
      </Commands>
    </ComponentEntry>
    <ComponentEntry
        AppName="DoomChat"
        ModuleName="./Contents/DoomChat.dll"
        AppDescription="The CivDOOM lobby chat (DOOMCHAT)."
        LoadOnAutoCADStartup="True">
      <Commands GroupName="DOOMCHAT">
        <Command Global="DOOMCHAT" Local="DOOMCHAT" />
        <Command Global="DOOMCHATFOLDER" Local="DOOMCHATFOLDER" />
        <Command Global="DOOMCHATSERVER" Local="DOOMCHATSERVER" />
        <Command Global="DOOMCHATNAME" Local="DOOMCHATNAME" />
        <Command Global="DOOMCHATNOTIFY" Local="DOOMCHATNOTIFY" />
      </Commands>
    </ComponentEntry>
  </Components>
</ApplicationPackage>
