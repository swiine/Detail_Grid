;Description : Presents Retaining Wall Plan
;              Adapted for 211798-TTW-01 xref naming, e.g.
;              211798-TTW-01-xf-cv-01000-geom-autoCAD-plan
;
;Created By  : David Arnold
;
;---------------------------------------------------------
;Retaining wall control xref file name (everything after the
;"211798-TTW-01-" prefix). CHANGE THIS if your file uses a
;different discipline number, e.g. xf-cv-01000-rwal-ctrl-plan.dwg
;---------------------------------------------------------
(setq rwal-xref "xf-cv-00000-rwal-ctrl-plan.dwg")
;
-xref d "*rwal-ctrl*"
;
TILEMODE
1
(command "ucs" "w")
-layer
s
z_xref
;
(command
"-XREF"
"O"
(strcat "..\\..\\..\\sheets\\" (substr (getvar "dwgname") 12 1) "\\" (substr (getvar "dwgname") 13 1) "\\Xrefs\\" (substr (getvar "dwgname") 1 14) rwal-xref)
"0,0"
"1"
"1"
"0")
;
(command "ucs" "v")
;=======================================================
;Xref Control
;=======================================================
-xref R "*plan*"
-xref R "*splice*"
-xref U "*demo-plan*"
-xref U "*surv-contours-plan*"
-xref U "*geom-cont-plan*"
-xref U "*geom-ctrl-plan*"
-xref U "*envi-plan*"
-xref U "*ssoil-subsoil-plan*"
-xref U "*strm-id-plan*"
-xref U "*util-sewer-id-plan*"
-xref U "*pave-jointing-plan*"
-xref U "*vhcl-turning-demonstrations-plan*"
