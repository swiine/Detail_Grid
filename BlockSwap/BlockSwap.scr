; =====================================================================
; BlockSwap.scr  -  single script for Autodesk Batch Save Utility
; In each drawing: delete the blocks in BS-DELETE, purge, then copy the
; blocks in BS-COPY from the template at their exact original location
; (same as COPYCLIP + PASTEORIG). Batch Save Utility saves the drawing.
;
; EDIT ONLY THE 4 LINES BELOW.
;  - Block names go in quotes. Wildcards OK, e.g. "REV_TAG*".
;  - BS-COPY set to nil copies EVERY block in the template.
;  - Use forward slashes / in paths.
; =====================================================================
(setq BS-DELETE '("OLD_TITLEBLOCK" "OLD_LOGO"))
(setq BS-COPY '("NEW_TITLEBLOCK" "NEW_LOGO"))
(setq BS-TEMPLATE "C:/CAD/Template.dwg")
(setq BS-LOG "C:/CAD/BlockSwap.log")
; ===================== nothing to edit below =========================
(vl-load-com)
(defun BS:Log (msg / f)
  (princ (strcat "\nBlockSwap: " msg))
  (if (and BS-LOG (setq f (open BS-LOG "a")))
    (progn
      (write-line (strcat (getvar "DWGPREFIX") (getvar "DWGNAME") " | " msg) f)
      (close f))))
(defun BS:Match (name patterns)
  (vl-some '(lambda (pat) (wcmatch (strcase name) (strcase pat))) patterns))
(defun BS:EffName (obj)
  (if (vlax-property-available-p obj 'EffectiveName)
    (vla-get-EffectiveName obj)
    (vla-get-Name obj)))
(defun BS:DeleteBlocks (doc / locked ss i obj n)
  (setq locked '() n 0)
  (vlax-for lay (vla-get-Layers doc)
    (if (= (vla-get-Lock lay) :vlax-true)
      (progn (setq locked (cons lay locked)) (vla-put-Lock lay :vlax-false))))
  (if (setq ss (ssget "_X" '((0 . "INSERT"))))
    (repeat (setq i (sslength ss))
      (setq obj (vlax-ename->vla-object (ssname ss (setq i (1- i)))))
      (if (and (BS:Match (BS:EffName obj) BS-DELETE)
               (not (vl-catch-all-error-p (vl-catch-all-apply 'vla-Delete (list obj)))))
        (setq n (1+ n)))))
  (foreach lay locked (vla-put-Lock lay :vlax-true))
  n)
(defun BS:CheckLeftovers (doc / left)
  (setq left "")
  (vlax-for blk (vla-get-Blocks doc)
    (if (and (= (vla-get-IsLayout blk) :vlax-false)
             (= (vla-get-IsXRef blk) :vlax-false)
             (BS:Match (vla-get-Name blk) BS-DELETE))
      (setq left (strcat left " " (vla-get-Name blk)))))
  (if (/= left "")
    (BS:Log (strcat "WARNING still defined after purge (nested?):" left))))
(defun BS:OpenTemplate (path / dbx)
  (setq dbx (vla-GetInterfaceObject (vlax-get-acad-object)
              (strcat "ObjectDBX.AxDbDocument." (substr (getvar "ACADVER") 1 2))))
  (if (vl-catch-all-error-p (vl-catch-all-apply 'vla-Open (list dbx path)))
    (progn (vlax-release-object dbx) nil)
    dbx))
(defun BS:TargetLayout (doc name / lay first)
  (setq lay (vl-catch-all-apply 'vla-Item (list (vla-get-Layouts doc) name)))
  (if (vl-catch-all-error-p lay)
    (progn
      (vlax-for l (vla-get-Layouts doc)
        (if (and (/= (strcase (vla-get-Name l)) "MODEL")
                 (or (not first) (< (vla-get-TabOrder l) (vla-get-TabOrder first))))
          (setq first l)))
      (if first (BS:Log (strcat "no layout \"" name "\", using \"" (vla-get-Name first) "\"")))
      first)
    lay))
(defun BS:CopyFromTemplate (doc / dbx objs arr target n res)
  (setq n 0)
  (cond
    ((not (findfile BS-TEMPLATE)) (BS:Log (strcat "MISSING TEMPLATE " BS-TEMPLATE)))
    ((not (setq dbx (BS:OpenTemplate (findfile BS-TEMPLATE)))) (BS:Log (strcat "COULD NOT OPEN TEMPLATE " BS-TEMPLATE)))
    (t
      (vlax-for tlay (vla-get-Layouts dbx)
        (setq objs '())
        (vlax-for ent (vla-get-Block tlay)
          (if (and (= (vla-get-ObjectName ent) "AcDbBlockReference")
                   (or (not BS-COPY) (BS:Match (BS:EffName ent) BS-COPY)))
            (setq objs (cons ent objs))))
        (if objs
          (if (setq target (BS:TargetLayout doc (vla-get-Name tlay)))
            (progn
              (setq arr (vlax-make-safearray vlax-vbObject (cons 0 (1- (length objs)))))
              (vlax-safearray-fill arr objs)
              (if (vl-catch-all-error-p
                    (setq res (vl-catch-all-apply 'vla-CopyObjects (list dbx arr (vla-get-Block target)))))
                (BS:Log (strcat "ERROR copying into \"" (vla-get-Name target) "\": " (vl-catch-all-error-message res)))
                (setq n (+ n (length objs)))))
            (BS:Log (strcat "no layout to copy \"" (vla-get-Name tlay) "\" blocks into")))))
      (vlax-release-object dbx)))
  n)
(defun BS:Run (/ doc del ins)
  (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)))
  (vla-StartUndoMark doc)
  (setq del (BS:DeleteBlocks doc))
  (repeat 3 (vla-PurgeAll doc))
  (BS:CheckLeftovers doc)
  (setq ins (BS:CopyFromTemplate doc))
  (vla-EndUndoMark doc)
  (BS:Log (strcat "deleted " (itoa del) " block(s), copied in " (itoa ins) " block(s)"))
  (princ))
(BS:Run)
