<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Civil 3D 2026 plugin (AutoCAD 2026 runs on .NET 8).
    Build:   dotnet build src/DerZombies.Civil3D -c Release
    Then NETLOAD bin\Release\net8.0-windows\DerZombies.Civil3D.dll in Civil 3D 2026.

    The AutoCAD and Civil 3D APIs come from Autodesk's official reference packages
    on NuGet, so Civil 3D does not need to be installed to build. They are
    compile-only (ExcludeAssets=runtime): at run time Civil 3D supplies its own DLLs.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>DerZombies.Civil3D</RootNamespace>
    <AssemblyName>DerZombies.Civil3D</AssemblyName>
    <!-- Autodesk's reference DLLs are x64-only; that matches PlatformTarget. -->
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>

  <!-- The engine is compiled straight into this DLL so there is only one file to NETLOAD. -->
  <ItemGroup>
    <Compile Include="..\DerZombies.Core\**\*.cs" Exclude="..\DerZombies.Core\bin\**;..\DerZombies.Core\obj\**" LinkBase="Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms (frame timer) and WPF (the MSG type in AutoCAD's PreTranslateMessage). -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- AutoCAD 2026 .NET API: accoremgd, acdbmgd, acmgd -->
    <PackageReference Include="AutoCAD.NET" Version="25.1.0" ExcludeAssets="runtime" />
    <!-- Civil 3D 2026 .NET API: AeccDbMgd, AecBaseMgd, ... -->
    <PackageReference Include="Civil3D.NET" Version="13.8.280" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
