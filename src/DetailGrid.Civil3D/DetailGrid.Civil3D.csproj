<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Civil 3D 2026 plugin (AutoCAD 2026 runs on .NET 8).
    Build:  dotnet build -c Release
    Override the install folder with:  dotnet build -p:Civil3DPath="D:\Autodesk\AutoCAD 2026"
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DetailGrid.Civil3D</AssemblyName>
    <RootNamespace>DetailGrid.Civil3D</RootNamespace>
    <Civil3DPath Condition="'$(Civil3DPath)' == ''">C:\Program Files\Autodesk\AutoCAD 2026</Civil3DPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="accoremgd"><HintPath>$(Civil3DPath)\accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acdbmgd"><HintPath>$(Civil3DPath)\acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acmgd"><HintPath>$(Civil3DPath)\acmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AecBaseMgd"><HintPath>$(Civil3DPath)\ACA\AecBaseMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AeccDbMgd"><HintPath>$(Civil3DPath)\C3D\AeccDbMgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DetailGrid.Hydrology\DetailGrid.Hydrology.csproj" />
  </ItemGroup>

</Project>
