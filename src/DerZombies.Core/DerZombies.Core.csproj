<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure game engine: no AutoCAD / Civil 3D references, so it can be built and
       simulated anywhere. The Civil 3D plugin renders it inside a drawing. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DerZombies.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DerZombies.Tests" />
  </ItemGroup>

</Project>
