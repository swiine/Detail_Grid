<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The CivDOOM game server (lobby + relay for co-op games). Run CivDoom.Server.exe on any PC everyone can
    reach; players point CIVDOOMNET at that PC. Needs only the .NET 8 runtime (no ASP.NET, no other tools).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>LatestMajor</RollForward>
    <AssemblyName>CivDoom.Server</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CivDoom.Engine\CivDoom.Engine.csproj" />
  </ItemGroup>
</Project>
