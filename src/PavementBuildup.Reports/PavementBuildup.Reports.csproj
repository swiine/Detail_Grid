    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PavementBuildup.Reports</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- ClosedXML (MIT): writes .xlsx with formatting and hyperlinks. -->
