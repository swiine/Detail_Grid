<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>TTW Pavement</AssemblyName>
    <RootNamespace>PavementBuildup</RootNamespace>
    <ApplicationIcon>ttw.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <Using Include="System.Windows.Forms" />
    <Using Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\PavementBuildup\Brand.cs" Link="Shared\Brand.cs" />
    <Compile Include="..\PavementBuildup\PreviewPanel.cs" Link="Shared\PreviewPanel.cs" />
    <Compile Include="..\PavementBuildup\ProblemForm.cs" Link="Shared\ProblemForm.cs" />
    <EmbeddedResource Include="..\PavementBuildup\Assets\*.png" LogicalName="PavementBuildup.Assets.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PavementBuildup.Core\PavementBuildup.Core.csproj" />
    <ProjectReference Include="..\PavementBuildup.Export\PavementBuildup.Export.csproj" />
    <ProjectReference Include="..\PavementBuildup.Reports\PavementBuildup.Reports.csproj" />
  </ItemGroup>
</Project>
