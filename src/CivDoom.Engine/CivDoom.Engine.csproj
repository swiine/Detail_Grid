<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure game engine: no AutoCAD or WinForms dependencies, so it can be unit tested anywhere. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CivDoom.Engine</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The shipped monster designs. Also written out as editable files next to the plugin. -->
    <EmbeddedResource Include="Monsters\**\*.txt" LogicalName="CivDoom.Engine.Monsters.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Weapons\**\*.txt" LogicalName="CivDoom.Engine.Weapons.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Themes\**\*.txt" LogicalName="CivDoom.Engine.Themes.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Player\**\*.txt" LogicalName="CivDoom.Engine.Player.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CivDoom.Engine.Tests" />
  </ItemGroup>
</Project>
