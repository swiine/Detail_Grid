<Project Sdk="Microsoft.NET.Sdk">
  <!-- Civil 3D 2026 / AutoCAD 2026 plugin (.NET 8). Load with NETLOAD or install the .bundle. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>PavementBuildup</RootNamespace>
    <AssemblyName>PavementBuildup</AssemblyName>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- AutoCAD 2026 API (R25.1): AcCoreMgd, AcDbMgd, AcMgd. Compile-time only (the same as Copy Local = False):
         Civil 3D supplies these DLLs at runtime and they are never shipped in the bundle. -->
    <PackageReference Include="AutoCAD.NET" Version="25.1.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- TTW logos for the window header, compiled into the DLL -->
    <EmbeddedResource Include="Assets\*.png" LogicalName="PavementBuildup.Assets.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PavementBuildup.Core\PavementBuildup.Core.csproj" />
  </ItemGroup>
</Project>
