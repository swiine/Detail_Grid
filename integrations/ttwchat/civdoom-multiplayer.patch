+    Task BroadcastExcept(string channel, Client except, object payload)
+    {
+        var bytes = JsonSerializer.SerializeToUtf8Bytes(payload, Json);
+        var targets = _clients.Keys.Where(c => c != except && c.User != null && c.Channels.Contains(channel)).ToArray();
+        return Task.WhenAll(targets.Select(c => SendRaw(c, bytes)));
+    }
