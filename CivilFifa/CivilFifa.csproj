<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Civil 3D 2026 / AutoCAD 2026 run on .NET 8 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>CivilFifa</AssemblyName>
    <RootNamespace>CivilFifa</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- AutoCAD 2026 managed API (acdbmgd / acmgd / accoremgd). Compile-time only:
         Civil 3D supplies these assemblies at runtime. -->
    <PackageReference Include="AutoCAD.NET" Version="25.1.0">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
