<Project Sdk="Microsoft.NET.Sdk">

  <!-- TTW Plugin Tools: the Advanced Tools window, but for compiled .dll plugins.
       Built for AutoCAD / Civil 3D 2026 (.NET 8). -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>TTW.PluginTools</RootNamespace>
    <AssemblyName>TTW.PluginTools</AssemblyName>
    <Version>1.0.0</Version>
    <!-- Lets the project build on a machine without Windows (CI); harmless on Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Put the dependency (MetadataLoadContext) next to the DLL so the folder is ready to deploy -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- AutoCAD API: compile against it, never ship it (Civil 3D has its own copy) -->
    <PackageReference Include="AutoCAD.NET" Version="25.1.0" ExcludeAssets="runtime" />
    <!-- Reads plugin DLLs without loading or locking them -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\*.png" />
    <None Include="..\..\deploy\TTW.PluginTools.config.json" Link="TTW.PluginTools.config.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
