<!--
  TTW Plugin Tools window. Same layout and look as TTW Advanced Tools, but the list
  holds commands from compiled .dll plugins instead of .csx scripts.
  Themed through DynamicResource keys that PluginWindow.xaml.cs builds from ThemeConfig:
    B.*  brushes   F.*  font families
  Kept deliberately simple: find a tool, read what it does, run it.
  Everything else lives on the right-click menu.
-->
<Window x:Class="TTW.PluginTools.PluginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TTW Plugin Tools" Width="820" Height="560" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <Grid x:Name="Root"
        Background="{DynamicResource B.Bg}"
        TextElement.FontFamily="{DynamicResource F.Body}"
        TextElement.FontSize="12.5"
        TextElement.Foreground="{DynamicResource B.Text}"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True" UseLayoutRounding="True">

    <Grid.Resources>
      <BooleanToVisibilityConverter x:Key="BoolVis"/>

      <!-- Square, flat button - the brand is engineered, not bubbly -->
      <Style x:Key="Primary" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource B.AccentFg}"/>
        <Setter Property="Background" Value="{DynamicResource B.Accent}"/>
        <Setter Property="Padding" Value="22,0"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.AccentHover}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.AccentHover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="Secondary" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource B.Accent}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Border}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="Icon" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource B.Muted}"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Icon}"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="Transparent">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource F.Icon}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>

      <Style x:Key="ToolItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0" Padding="13,8,12,8">
                <ContentPresenter/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Selection}"/>
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- header -->
      <RowDefinition Height="*"/>     <!-- list | description -->
      <RowDefinition Height="Auto"/>  <!-- status -->
    </Grid.RowDefinitions>

    <!-- ===== Header: Water Blue band, logo top right ===== -->
    <Border Grid.Row="0" Background="{DynamicResource B.HeaderBg}" Padding="22,14,22,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Text="Plugin Tools" FontFamily="{DynamicResource F.Heading}" FontSize="26"
                     Foreground="{DynamicResource B.HeaderFg}" TextOptions.TextFormattingMode="Ideal"/>
          <TextBlock x:Name="SubtitleText" Text="Civil 3D" FontSize="11.5" Margin="1,1,0,0"
                     Foreground="{DynamicResource B.HeaderSubtle}"/>
        </StackPanel>
        <Image x:Name="Logo" Grid.Column="1" Height="30" VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
      </Grid>
    </Border>

    <!-- ===== List | description ===== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ListColumn" Width="260" MinWidth="200"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*" MinWidth="260"/>
      </Grid.ColumnDefinitions>

      <!-- List -->
      <DockPanel Grid.Column="0">
        <Border x:Name="SearchBorder" DockPanel.Dock="Top" Margin="12,12,12,6" Height="32"
                Background="{DynamicResource B.Surface}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Margin="10,0,6,0" Foreground="{DynamicResource B.Muted}"/>
            <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Search" Margin="3,0,0,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource B.Muted}" IsHitTestVisible="False"/>
            <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                     VerticalContentAlignment="Center" Foreground="{DynamicResource B.Text}"
                     CaretBrush="{DynamicResource B.Text}" FontSize="12.5"/>
            <Button x:Name="ClearSearch" Grid.Column="2" Style="{StaticResource Icon}" Content="&#xE894;"
                    Margin="0,0,3,0" Visibility="Collapsed" ToolTip="Clear (Esc)"/>
          </Grid>
        </Border>

        <Grid>
          <ListBox x:Name="List" BorderThickness="0" Background="Transparent"
                   ItemContainerStyle="{StaticResource ToolItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingPanel.IsVirtualizingWhenGrouping="True">
            <ListBox.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold" Margin="16,12,12,4"
                               Foreground="{DynamicResource B.Muted}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Name}" Value="">
                              <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Style="{StaticResource Glyph}" Text="&#xE714;" FontSize="11"
                             Margin="8,0,0,0" Foreground="{DynamicResource B.Muted}" ToolTip="Has a tutorial video"
                             Visibility="{Binding HasVideo, Converter={StaticResource BoolVis}}"/>
                  <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Not hit-testable, so right-clicking it still opens the list's menu (Change tools folder...) -->
          <TextBlock x:Name="ListEmpty" Margin="16,10" TextWrapping="Wrap" Foreground="{DynamicResource B.Muted}"
                     Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="Transparent" ResizeBehavior="PreviousAndNext" Focusable="False"/>

      <!-- Description -->
      <Border Grid.Column="2" Background="{DynamicResource B.Surface}"
              BorderBrush="{DynamicResource B.Border}" BorderThickness="1,0,0,0">
        <Grid>
          <!-- Nothing selected -->
          <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <Image x:Name="EmptyMark" Width="52" Height="52" Opacity="0.14" Margin="0,0,0,16"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="260" TextWrapping="Wrap"
                       Foreground="{DynamicResource B.Muted}" Text="Pick a tool to see what it does."/>
          </StackPanel>

          <DockPanel x:Name="Detail" Visibility="Collapsed" Margin="28,24,28,24">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontFamily="{DynamicResource F.Heading}" FontSize="26"
                       Foreground="{DynamicResource B.Heading}" TextWrapping="Wrap" TextOptions.TextFormattingMode="Ideal"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Details}" Margin="1,4,0,0" FontSize="11"
                       Foreground="{DynamicResource B.Muted}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding DllPath}"/>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,18,0,0">
              <Button x:Name="RunButton" Style="{StaticResource Primary}" ToolTip="Run in the current drawing (Enter or double-click)">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Margin="0,0,9,0"/>
                  <TextBlock Text="Run"/>
                </StackPanel>
              </Button>
              <Button x:Name="WatchButton" Style="{StaticResource Secondary}" Margin="10,0,0,0" ToolTip="Watch how to use this tool"
                      Visibility="{Binding HasVideo, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE714;" Margin="0,0,8,0"/>
                  <TextBlock x:Name="WatchButtonText" Text="Watch tutorial"/>
                </StackPanel>
              </Button>
            </StackPanel>

            <Grid>
              <!-- What the tool does -->
              <ScrollViewer x:Name="DescriptionArea" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                  <TextBlock Text="{Binding ModeDisplay}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11.5"
                             Foreground="{DynamicResource B.Read}"
                             Visibility="{Binding HasModeDisplay, Converter={StaticResource BoolVis}}"/>

                  <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11.5"
                             Foreground="{DynamicResource B.Failure}"
                             Visibility="{Binding HasWarning, Converter={StaticResource BoolVis}}"/>

                  <TextBlock Text="{Binding DescriptionDisplay}" TextWrapping="Wrap" Margin="0,16,0,0" FontSize="13.5"
                             LineHeight="20">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasDescription}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource B.Muted}"/>
                            <Setter Property="FontStyle" Value="Italic"/>
                            <Setter Property="FontSize" Value="12.5"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </ScrollViewer>

              <!-- Tutorial video -->
              <DockPanel x:Name="VideoArea" Visibility="Collapsed" Margin="0,14,0,0">
                <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Button x:Name="PlayPause" Style="{StaticResource Icon}" Content="&#xE769;" FontSize="12"
                          Width="30" Height="30" Foreground="{DynamicResource B.Accent}" ToolTip="Play / pause (Space)"/>
                  <Slider x:Name="VideoSlider" Grid.Column="1" VerticalAlignment="Center" Margin="6,0,10,0"
                          Minimum="0" Maximum="1" IsMoveToPointEnabled="True" Focusable="False"/>
                  <TextBlock x:Name="VideoTime" Grid.Column="2" VerticalAlignment="Center" FontSize="11"
                             Foreground="{DynamicResource B.Muted}" Text="0:00 / 0:00" Margin="0,0,8,0"/>
                  <Button x:Name="VideoExternal" Grid.Column="3" Style="{StaticResource Icon}" Content="&#xE8A7;" FontSize="12"
                          Width="30" Height="30" ToolTip="Open in your video player (bigger)"/>
                </Grid>
                <Border Background="Black">
                  <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform"
                                ScrubbingEnabled="True" Cursor="Hand"/>
                </Border>
              </DockPanel>
            </Grid>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ===== Status line: the last result ===== -->
    <Border Grid.Row="2" Background="{DynamicResource B.Bg}" BorderBrush="{DynamicResource B.Border}"
            BorderThickness="0,1,0,0" Padding="14,7,14,7">
      <DockPanel>
        <TextBlock x:Name="StatusGlyph" DockPanel.Dock="Left" Style="{StaticResource Glyph}" Margin="0,0,8,0" Visibility="Collapsed"/>
        <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{DynamicResource B.Muted}"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   Text="Double-click a tool to run it. Right-click for more."/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
